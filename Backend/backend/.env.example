DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/AI_ML_project

# AI agent (free): get a key at https://console.groq.com/keys
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Elasticsearch (optional; app falls back to Postgres search if down)
ELASTICSEARCH_URL=http://localhost:9200

# Scan questions: local llama.cpp server and durable OCR worker
OCR_UPLOAD_DIR=uploaded_ocr
OCR_LLAMA_URL=http://127.0.0.1:8081/v1/chat/completions
OCR_LLAMA_MODEL=paddleocr-vl-1.6-bangla
OCR_LLAMA_TIMEOUT=300
OCR_WORKER_POLL_SECONDS=2
OCR_STALE_SECONDS=900
